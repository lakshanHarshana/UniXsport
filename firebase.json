{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git/**",
      ".git",
      "**/.git/**",
      ".firebase/**",
      ".firebase",
      "**/.*",
      "node_modules/**",
      "node_modules",
      "**/node_modules/**",
      "server/**",
      "server",
      "RFID/**",
      "hardware/**",
      "uploads/**",
      "package.json",
      "package-lock.json",
      "*.md",
      "*.txt",
      "*.log"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/home.html"
      }
    ]
  }
}
